# API Server — Environment Variables
# Copy to .env and fill in values for local development

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, Neon, or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/greenvolt

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production
# In development, localhost:* is allowed automatically
ALLOWED_ORIGINS=https://greenvolt-admin.vercel.app,https://greenvolt.in

# ── Twilio SMS (optional — falls back to mock/log mode if not set) ────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Sentry Error Tracking (optional) ─────────────────────────────────────────
SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxxxx
