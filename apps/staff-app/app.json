{
  "expo": {
    "name": "GreenVolt",
    "slug": "greenvolt-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "greenvolt-staff",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00450d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.greenvolt.staff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00450d"
      },
      "package": "in.greenvolt.staff",
      "versionCode": 1,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 26,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "greenvolt.in",
              "pathPrefix": "/app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "GreenVolt needs camera access to photograph service jobs before and after completion."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GreenVolt needs photo library access to attach existing photos to service reports.",
          "cameraPermission": "GreenVolt needs camera access to photograph service jobs before and after completion."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00450d",
          "defaultChannel": "greenvolt-jobs",
          "sounds": []
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "newArchEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "a92f7c18-0248-496d-9960-35f5fb06f912"
      }
    }
  }
}
