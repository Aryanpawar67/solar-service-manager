# Staff App — Environment Variables
# Copy to .env.local and fill in values

# API server base URL (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry DSN for error tracking (optional — leave blank to disable)
EXPO_PUBLIC_SENTRY_DSN=

# EAS Project ID — added automatically by `eas init`, do not edit manually
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
